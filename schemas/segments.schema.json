{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "segments"],
  "properties": {
    "schema_version": { "type": "string" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "text"],
        "properties": {
          "segment_id": { "type": "integer" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
